@{
    ViewData["Title"] = "Architecture Comparison";
}
<style>
    /* Highlight table rows on hover */
    .comparison-table tbody tr:hover {
        background-color: darkorange; /* Light blue highlight */
        color: white;
        cursor: pointer;
        font-weight: normal;
        transition: background-color 0.2s ease-in-out;
    }
    /* Clicked (selected) highlight */
    .comparison-table tbody tr.selected {
        background-color: orangered !important; /* Slightly darker blue */
        color: white;
        font-weight: bold;
    }

    #detailContent {
        opacity: 0;
        background-color: lightyellow;
        transition: opacity 0.3s ease-in-out;
    }

        #detailContent.visible {
            opacity: 1;
        }

    .diagram {
        font-family: Consolas, monospace;
        padding: 10px 12px;
        background: lightyellow;
        border-radius: 6px;
        border: 1px solid #ddd;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.4s ease, transform 0.4s ease;
        white-space: pre;
        overflow-x: auto;
        word-break: break-word; /* break long lines if needed */
        overflow-wrap: break-word; /* modern fallback */
        max-width: 100%; /* never exceed the card width */
    }

        .diagram.visible {
            opacity: 1;
            transform: translateY(0);
        }
</style>



<h1 class="mb-4">WPF / MVVM vs ASP.NET Core MVC</h1>

<div class="alert alert-info">
    This application demonstrates the <strong>same SchoolModel domain</strong> implemented in two different UI architectures:
    <strong>WPF with MVVM</strong> and <strong>ASP.NET Core MVC</strong>.
</div>

<div class="row">
    <!-- LEFT: Comparison Table -->
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">High-Level Comparison</h4>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-bordered mb-0 comparison-table">
                    <thead class="table-dark">
                        <tr>
                            <th>WPF / MVVM</th>
                            <th>ASP.NET Core MVC</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr data-detail="desktopWeb">
                            <td>Desktop application (Windows-only)</td>
                            <td>Web application (browser-based)</td>
                        </tr>

                        <tr data-detail="xamlRazor">
                            <td>XAML UI with data binding</td>
                            <td>Razor views rendered on the server</td>
                        </tr>

                        <tr data-detail="vmController">
                            <td>ViewModel holds UI logic and state</td>
                            <td>Controller handles requests and returns views</td>
                        </tr>

                        <tr data-detail="statefulStateless">
                            <td>UI is stateful — objects stay alive</td>
                            <td>UI is stateless — each request is new</td>
                        </tr>

                        <tr data-detail="observableEnumerable">
                            <td>ObservableCollection updates UI automatically</td>
                            <td>Model data is passed once per request</td>
                        </tr>

                        <tr data-detail="commandsVerbs">
                            <td>Commands (ICommand) trigger actions</td>
                            <td>HTTP verbs (GET/POST) trigger actions</td>
                        </tr>

                        <tr data-detail="navigation">
                            <td>Navigation swaps Views inside a Window</td>
                            <td>Navigation loads new pages via URLs</td>
                        </tr>

                        <tr data-detail="validation">
                            <td>Validation in ViewModel</td>
                            <td>Validation via ModelState + DataAnnotations</td>
                        </tr>

                        <tr data-detail="runtime">
                            <td>Runs locally on the user's machine</td>
                            <td>Runs on a server and serves multiple users</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RIGHT: Dynamic Side Panel -->
    <div class="col-md-5">
        <div class="card" id="detailPanel">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Explanation</h4>
            </div>

            <div class="card-body">
                <div id="detailContent">
                    <p>Select a row to see deeper details.</p>
                </div>

                <div id="diagramArea" class="mt-3"></div>
            </div>
        </div>
    </div>

</div>



