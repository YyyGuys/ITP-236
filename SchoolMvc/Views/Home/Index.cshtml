<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <h4 class="mb-0">Shared Domain Model</h4>
    </div>
    <div class="card-body">
        <p>
            Both architectures use the <strong>same SchoolModel</strong>:
        </p>
        <ul>
            <li>Student</li>
            <li>Course</li>
            <li>Enrollment</li>
            <li>Teacher </li>
            <li>Club</li>
        </ul>
        <p>
            This demonstrates that <strong>UI architecture can change</strong> while the
            <strong>domain model stays the same</strong>.
        </p>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Explore the MVC Version</h4>
    </div>
    <div class="card-body">
        <p>Select a section to explore the MVC implementation:</p>
        <ul>
            <li><a asp-controller="Students" asp-action="Index">Students</a></li>
            <li><a asp-controller="Courses" asp-action="Index">Courses</a></li>
            <li><a asp-controller="Teachers" asp-action="Index">Teachers</a></li>
            <li><a asp-controller="Clubs" asp-action="Index">Clubs</a></li>
        </ul>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const rows = document.querySelectorAll(".comparison-table tbody tr");
            const detailContent = document.getElementById("detailContent");
            const diagramArea = document.getElementById("diagramArea");

            // Deep explanations for each row
            const details = {
                desktopWeb: `
                    <h5>Desktop vs Web</h5>
                    <p>WPF apps run locally on Windows and maintain in-memory state.</p>
                    <p>MVC apps run on a server and deliver HTML to any browser.</p>
                `,
                xamlRazor: `
                    <h5>XAML vs Razor</h5>
                    <p>XAML supports two-way data binding and reactive UI updates.</p>
                    <p>Razor renders HTML once per request and relies on HTTP round-trips.</p>
                `,
                vmController: `
                    <h5>ViewModel vs Controller</h5>
                    <p>MVVM uses ViewModels to hold UI state, commands, and logic.</p>
                    <p>MVC uses Controllers to handle requests, load data, and return views.</p>
                `,
                statefulStateless: `
                    <h5>Stateful vs Stateless</h5>
                    <p>MVVM keeps objects alive in memory as long as the window is open.</p>
                    <p>MVC treats each request as new, so state must be reloaded each time.</p>
                `,
                observableEnumerable: `
                    <h5>ObservableCollection vs IEnumerable</h5>
                    <p>ObservableCollection automatically notifies the UI of changes.</p>
                    <p>MVC passes plain lists to views, and changes require a new request.</p>
                `,
                commandsVerbs: `
                    <h5>Commands vs HTTP Verbs</h5>
                    <p>MVVM uses ICommand to bind UI actions to ViewModel methods.</p>
                    <p>MVC uses GET and POST to trigger controller actions.</p>
                `,
                navigation: `
                    <h5>Navigation Differences</h5>
                    <p>WPF swaps Views inside a Window.</p>
                    <p>MVC navigates by changing URLs, each mapped to a controller action.</p>
                `,
                validation: `
                    <h5>Validation Differences</h5>
                    <p>MVVM typically validates inside the ViewModel.</p>
                    <p>MVC uses ModelState and DataAnnotations to validate incoming form data.</p>
                `,
                runtime: `
                    <h5>Runtime Environment</h5>
                    <p>WPF apps run on the user’s machine with full access to local resources.</p>
                    <p>MVC apps run on a server and serve multiple users simultaneously.</p>
                `
            };

            // Animated diagrams for each row
            const diagrams = {
                desktopWeb: `
        MVVM (Desktop)
        ---------------
        View → ViewModel → Model
        ↑                 |
        |_________________|

        MVC (Web)
        ---------------
        Request → Controller → Model → View → Response
                `,
                xamlRazor: `
        MVVM Binding Flow
        ------------------
        XAML ↔ ViewModel ↔ Model

        MVC Rendering Flow
        ------------------
        Razor View ← Controller ← Model
                `,
                vmController: `
        MVVM
        ------
        View → ViewModel → Model

        MVC
        ------
        Request → Controller → Model → View
                `,
                statefulStateless: `
        MVVM (Stateful)
        ----------------
        [Window Open]
          ViewModel Alive
          Objects Persist

        MVC (Stateless)
        ----------------
        [Request]
          Controller → View
        [End Request]
                `,
                observableEnumerable: `
        MVVM
        ------
        ObservableCollection
          ↳ Auto UI Updates

        MVC
        ------
        IEnumerable
          ↳ New Request Needed
                `,
                commandsVerbs: `
        MVVM
        ------
        Button → ICommand → ViewModel Method

        MVC
        ------
        Form → POST → Controller Action
                `,
                navigation: `
        MVVM Navigation
        ----------------
        Window
          ↳ Swap Views

        MVC Navigation
        ----------------
        Browser
          ↳ New URL → New Action
                `,
                validation: `
        MVVM Validation
        ----------------
        ViewModel
          ↳ Property Validation

        MVC Validation
        ----------------
        ModelState + DataAnnotations
                `,
                runtime: `
        MVVM Runtime
        --------------
        Runs locally
        Full access to OS

        MVC Runtime
        --------------
        Runs on server
        Multiple users
                `
            };

            rows.forEach(row => {
                row.addEventListener("click", function () {

                    // Highlight selected row
                    rows.forEach(r => r.classList.remove("selected"));
                    this.classList.add("selected");

                    // Update side panel text
                    const key = this.getAttribute("data-detail");
                    detailContent.classList.remove("visible");
                    detailContent.innerHTML = details[key];

                    // Update diagram
                    diagramArea.innerHTML = `<pre class="diagram">${diagrams[key]}</pre>`;
                    const diagramElement = diagramArea.querySelector(".diagram");

                    // Fade in both text and diagram
                    setTimeout(() => {
                        detailContent.classList.add("visible");
                        diagramElement.classList.add("visible");
                    }, 50);
                });
            });

        });
    </script>
}





