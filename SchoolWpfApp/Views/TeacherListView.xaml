<UserControl x:Class="SchoolWpfApp.Views.TeacherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <TextBlock Text="Teachers"
           FontSize="24"
           FontWeight="Bold"
           Margin="0 0 0 10" />
        <DataGrid ItemsSource="{Binding Teachers}"
                  SelectedItem="{Binding SelectedTeacher}"
                  CanUserAddRows="False" 
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tag" Binding="{Binding FullName}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="View Details"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="DarkSlateBlue" Foreground="White"
                Margin="10,10,0,4"
                Width="120" Height="22" 
                FontSize="14" FontWeight="Bold"
                Command="{Binding ViewDetailCommand}"
                CommandParameter="{Binding SelectedTeacher}"/>
    </Grid>
</UserControl>