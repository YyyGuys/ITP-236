<UserControl x:Class="SchoolWpfApp.Views.CourseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">

        <!-- Form Grid -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Tag:" Margin="0 0 10 10" />
            <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding Course.Tag}"
                 FontSize="20"
                 FontWeight="Bold"
                 Margin="0 0 0 10" />

            <TextBlock Grid.Row="1" Text="Title:" Margin="0 0 10 10" />
            <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding Course.Title}"
                 Margin="0 0 0 10" />

            <TextBlock Grid.Row="2" Text="Teacher:" Margin="0 0 10 10" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Teachers}"
                  SelectedValue="{Binding Course.TeacherId}"
                  SelectedValuePath="TeacherId"
                  DisplayMemberPath="FullName"
                  Margin="0 0 0 10" />

            <TextBlock Grid.Row="3" Text="Credits:" Margin="0 0 10 10" />
            <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding Course.Credits}"
                 Margin="0 0 0 10" />
        </Grid>

        <!-- Students Header -->
        <TextBlock Text="Enrolled Students"
               FontWeight="Bold"
               Margin="0 20 0 5" />

        <!-- Students List -->
        <DataGrid ItemsSource="{Binding Students}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" />
                <DataGridTextColumn Header="Major" Binding="{Binding Major}" />
                <DataGridTextColumn Header="GPA" Binding="{Binding GPA, StringFormat={}{0:F2}}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <Button Content="Save"
            Command="{Binding SaveCommand}"
            Margin="0,20,0,0" />

        <Button Content="Back"
            Command="{Binding BackCommand}" />

    </StackPanel>
</UserControl>