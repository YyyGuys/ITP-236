<UserControl x:Class="SchoolWpfApp.Views.CourseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <TextBlock Text="Courses"
           FontSize="24"
           FontWeight="Bold"
           Margin="0 0 0 10" />
        <DataGrid ItemsSource="{Binding Courses}"
                  SelectedItem="{Binding SelectedCourse}"
                  CanUserAddRows="False" 
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" />
                <DataGridTextColumn Header="Credits" Binding="{Binding Credits}" />
                <DataGridTextColumn Header="Students" Binding="{Binding EnrollmentCount}" />
                <DataGridTemplateColumn Header="Delete">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        Background="DeepPink" Foreground="White"
                        Width="60" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <Button Content="+ Course"
            Command="{Binding AddCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="ForestGreen" Foreground="White"
            Margin="10 10 0 4"
            Width="120" Height="22" 
                FontSize="14" FontWeight="Bold"/>

        <Button Content="View Details"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="DarkSlateBlue" Foreground="White"
                Margin="10,10,0,4"
                Width="120" Height="22" 
                FontSize="14" FontWeight="Bold"
                Command="{Binding ViewDetailCommand}"
                CommandParameter="{Binding SelectedCourse}"/>
    </Grid>
</UserControl>